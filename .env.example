# Optional. In-page contact form POST target.
# Formspree: https://formspree.io/f/xxxxxxxx
# Or any endpoint that accepts a JSON body with name, email, phone, siteType,
# systems, timeline, enquiryType, and message (Resend via your own function).
# When this is empty, the contact form opens the visitor's email app
# addressed to admin@precisioncabling.com.au with the enquiry filled in.
VITE_CONTACT_FORM_ENDPOINT=

# Optional. Cookieless Plausible analytics. Leave empty to load nothing.
# Example: precisioncabling.com.au
VITE_PLAUSIBLE_DOMAIN=
